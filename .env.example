# ---------------------------------------------------------------------------
# FRONTEND (se compila dentro del bundle → NO poner secretos acá)
# ---------------------------------------------------------------------------

# URL pública del endpoint serverless del Copilot.
# Si queda vacía, el Copilot funciona igual usando el motor de análisis local.
#   Vercel:  https://tu-proyecto.vercel.app/api/copilot
#   Netlify: https://tu-sitio.netlify.app/api/copilot
VITE_COPILOT_API_URL=

# Ruta base del build. Sólo para GitHub Pages (npm run build:pages ya la define).
# VITE_BASE=/gestor-precios-stock/


# ---------------------------------------------------------------------------
# BACKEND (se configuran en el panel del hosting, NUNCA en este repositorio)
# ---------------------------------------------------------------------------

# Clave de la API de Anthropic. Es secreta: vive sólo en el servidor.
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar. Por defecto claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# Origen autorizado a llamar al endpoint. Recomendado en producción.
# COPILOT_ALLOWED_ORIGIN=https://emilianost95-gif.github.io
